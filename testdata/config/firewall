config rule
	option name 'Allow-Ping'
	option src 'wan'
	option proto 'icmp'
	option icmp_type 'echo-request'
	option family 'ipv4'
	option target 'ACCEPT'

config rule
	option name 'Allow-WireGuard'
	option src 'wan'
	option proto 'udp'
	option dest_port '51820'
	option target 'ACCEPT'

config rule
	option name 'Guest-DNS-DHCP'
	option src 'guest'
	option proto 'tcp udp'
	option dest_port '53 67 68'
	option target 'ACCEPT'

config rule
	option name 'IoT-DNS-DHCP'
	option src 'iot'
	option proto 'tcp udp'
	option dest_port '53 67 68'
	option target 'ACCEPT'

config rule
	option name 'Kids-Night-Block'
	option src 'lan'
	option src_mac '6c:4a:85:19:e2:7a'
	option dest 'wan'
	option target 'REJECT'
	option start_time '22:00:00'
	option stop_time '06:30:00'
	list weekdays 'Sun Mon Tue Wed Thu'

config rule
	option name 'Block-Telnet-Out'
	option src 'lan'
	option dest 'wan'
	option proto 'tcp'
	option dest_port '23'
	option target 'DROP'
	option enabled '0'

