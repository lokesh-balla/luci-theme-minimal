	option forward 'REJECT'

config zone
	option name 'iot'
	list network 'iot'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'

config zone
	option name 'vpn'
	list network 'wg0'
	option input 'ACCEPT'
